{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": ["cli", "stdio", "http"]
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "env_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chelm_version": {
          "const": "1.4.0"
        },
        "harness_version": {
          "const": "0.14.0"
        }
      },
      "required": ["transport", "chelm_version", "harness_version"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "cli"
              }
            }
          },
          "then": {
            "required": ["root", "runtime"]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": ["command", "args"]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": ["url", "token_env"]
          }
        }
      ]
    },
    "inference": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["openai", "process"]
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "stream": {
          "type": "boolean"
        },
        "mode": {
          "enum": ["native_tools", "structured_text"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "openai"
              }
            }
          },
          "then": {
            "required": ["base_url", "model", "mode", "stream"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          },
          "then": {
            "required": ["command", "args"]
          }
        }
      ]
    },
    "executor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "agent"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "kind", "model", "host"],
      "additionalProperties": false
    },
    "queues": {
      "type": "array",
      "items": {
        "enum": ["memory", "cognitive"]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "context_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "request_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      },
      "required": [
        "rounds",
        "tool_calls",
        "context_bytes",
        "output_bytes",
        "elapsed_ms",
        "request_ms",
        "max_output_tokens",
        "max_total_tokens",
        "repairs",
        "cycles",
        "interval_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "state_dir",
    "host",
    "inference",
    "executor",
    "queues",
    "limits"
  ],
  "additionalProperties": false
}
